@model SalesPro.Domain.Entities.Customer

@{
    ViewData["Title"] = "Detalle cliente";
    ViewData["Header"] = "Detalle cliente";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="text-muted">@Model.Cedula</div>
                <h4 class="mb-1">@Model.FirstName @Model.LastName</h4>
                <div class="text-muted">@Model.Email</div>
                <div class="mt-2">
                    <div><span class="text-muted">Teléfono:</span> @Model.Phone</div>
                    <div><span class="text-muted">Dirección:</span> @Model.Address</div>
                </div>
            </div>
            <div class="text-end">
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge text-bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Inactivo</span>
                    }
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.CustomerId"><i class="bi bi-pencil me-2"></i>Editar</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.CustomerId"><i class="bi bi-trash me-2"></i>Eliminar</a>
            <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
        </div>
    </div>
</div>
