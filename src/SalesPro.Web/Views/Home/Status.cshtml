@{
    ViewData["Title"] = "Estado";
    ViewData["Header"] = "Estado";
    var code = (int)ViewBag.Code;
}

<div class="card">
    <div class="card-body">
        <h4 class="mb-2">Respuesta @code</h4>
        <div class="text-muted">El recurso solicitado no está disponible o no tienes acceso.</div>
        <div class="mt-3">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver</a>
        </div>
    </div>
</div>
