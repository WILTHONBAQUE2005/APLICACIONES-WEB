@model SalesPro.Web.ViewModels.ProductUpsertVm

@{
    ViewData["Title"] = "Nuevo producto";
    ViewData["Header"] = "Nuevo producto";
}

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label">Código</label>
                    <input class="form-control" asp-for="Code" placeholder="EJ: PROD-001" />
                    <span class="text-danger small" asp-validation-for="Code"></span>
                </div>
                <div class="col-12 col-md-8">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" asp-for="Name" />
                    <span class="text-danger small" asp-validation-for="Name"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Descripción</label>
                    <textarea class="form-control" asp-for="Description" rows="3"></textarea>
                    <span class="text-danger small" asp-validation-for="Description"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label">Precio</label>
                    <input class="form-control" asp-for="Price" type="number" step="0.01" min="0.01" />
                    <span class="text-danger small" asp-validation-for="Price"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label">Stock</label>
                    <input class="form-control" asp-for="Stock" type="number" step="1" min="0" />
                    <span class="text-danger small" asp-validation-for="Stock"></span>
                </div>
                <div class="col-12 col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive">Activo</label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" type="submit"><i class="bi bi-check2-circle me-2"></i>Guardar</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
