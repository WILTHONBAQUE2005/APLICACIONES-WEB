@model SalesPro.Domain.Entities.Product

@{
    ViewData["Title"] = "Detalle producto";
    ViewData["Header"] = "Detalle producto";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="text-muted">@Model.Code</div>
                <h4 class="mb-1">@Model.Name</h4>
                <div class="text-muted">@Model.Description</div>
            </div>
            <div class="text-end">
                <div class="fs-4 fw-semibold">@Model.Price.ToString("C")</div>
                <div class="text-muted">Stock: @Model.Stock</div>
                <div class="mt-1">
                    @if (Model.IsActive)
                    {
                        <span class="badge text-bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Inactivo</span>
                    }
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.ProductId"><i class="bi bi-pencil me-2"></i>Editar</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.ProductId"><i class="bi bi-trash me-2"></i>Eliminar</a>
            <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
        </div>
    </div>
</div>
