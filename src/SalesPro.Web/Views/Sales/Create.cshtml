@using System.Globalization
@model SalesPro.Web.ViewModels.SaleCreateVm

@{
    ViewData["Title"] = "Nueva venta";
    ViewData["Header"] = "Nueva venta";
}

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-2">Cliente</h5>
                <div class="text-muted mb-3">Busca por cédula o por nombres</div>

                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input id="customerQuery" class="form-control" placeholder="Escribe al menos 2 caracteres" autocomplete="off">
                </div>

                <div id="customerResults" class="list-group mt-2 d-none"></div>

                <div id="customerSelected" class="alert alert-light border mt-3 d-none">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold" id="customerName"></div>
                            <div class="text-muted small" id="customerMeta"></div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="customerClear"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>

                <div class="mt-4">
                    <h5 class="mb-2">IVA</h5>
                    <div class="text-muted mb-2">Tasa configurable</div>
                    <div class="input-group" style="max-width: 220px;">
                        <span class="input-group-text">%</span>
                        <input id="vatRate" class="form-control" type="number" step="0.01" min="0" max="100" value="@((Model.VatRate * 100m).ToString("0.##", CultureInfo.InvariantCulture))" />
                    </div>
                </div>

                <div class="mt-4">
                    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-2"></i>Volver</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-2">Productos</h5>
                <div class="text-muted mb-3">Busca por código o nombre</div>

                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input id="productQuery" class="form-control" placeholder="Escribe al menos 2 caracteres" autocomplete="off">
                </div>

                <div id="productResults" class="list-group mt-2 d-none"></div>

                <div id="msg" class="alert alert-danger mt-3 d-none"></div>

                <form method="post" asp-action="Create" class="mt-3" id="saleForm">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="CustomerId" id="CustomerId" value="0" />
                    <input type="hidden" name="VatRate" id="VatRateHidden" value="@Model.VatRate.ToString("0.####")" />
                    <div id="itemsInputs"></div>

                    <div class="table-responsive mt-2">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:130px;">Código</th>
                                    <th>Producto</th>
                                    <th style="width:110px;" class="text-end">Precio</th>
                                    <th style="width:130px;">Cantidad</th>
                                    <th style="width:120px;" class="text-end">Subtotal</th>
                                    <th style="width:50px;"></th>
                                </tr>
                            </thead>
                            <tbody id="cartBody">
                                <tr id="cartEmpty">
                                    <td colspan="6" class="text-center py-4 text-muted">Agrega productos para iniciar</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="row g-2 mt-2">
                        <div class="col-12 col-md-6">
                            <div class="card bg-light border">
                                <div class="card-body py-3">
                                    <div class="d-flex justify-content-between">
                                        <div class="text-muted">Subtotal</div>
                                        <div class="fw-semibold" id="subtotalText">$0.00</div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1">
                                        <div class="text-muted">IVA</div>
                                        <div class="fw-semibold" id="vatText">$0.00</div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-2 pt-2 border-top">
                                        <div class="fw-semibold">Total</div>
                                        <div class="fw-bold fs-5" id="totalText">$0.00</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 d-flex align-items-end justify-content-end gap-2">
                            <button class="btn btn-primary" type="submit" id="submitBtn" disabled>
                                <i class="bi bi-check2-circle me-2"></i>Registrar venta
                            </button>
                        </div>
                    </div>

                    <div asp-validation-summary="All" class="text-danger small mt-3"></div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        const customerQuery = document.getElementById('customerQuery');
        const customerResults = document.getElementById('customerResults');
        const customerSelected = document.getElementById('customerSelected');
        const customerName = document.getElementById('customerName');
        const customerMeta = document.getElementById('customerMeta');
        const customerClear = document.getElementById('customerClear');
        const customerIdHidden = document.getElementById('CustomerId');

        const productQuery = document.getElementById('productQuery');
        const productResults = document.getElementById('productResults');

        const vatRateInput = document.getElementById('vatRate');
        const vatRateHidden = document.getElementById('VatRateHidden');

        const cartBody = document.getElementById('cartBody');
        const cartEmpty = document.getElementById('cartEmpty');
        const itemsInputs = document.getElementById('itemsInputs');

        const subtotalText = document.getElementById('subtotalText');
        const vatText = document.getElementById('vatText');
        const totalText = document.getElementById('totalText');

        const msg = document.getElementById('msg');
        const submitBtn = document.getElementById('submitBtn');

        let selectedCustomer = null;
        const cart = new Map();

        function money(v) {
            return (Math.round(v * 100) / 100).toFixed(2);
        }

        function showMsg(text) {
            msg.textContent = text;
            msg.classList.remove('d-none');
        }

        function clearMsg() {
            msg.textContent = '';
            msg.classList.add('d-none');
        }

        function setCustomer(c) {
            selectedCustomer = c;
            customerIdHidden.value = c.id;
            customerName.textContent = c.fullName;
            customerMeta.textContent = c.cedula + (c.email ? ' · ' + c.email : '');
            customerSelected.classList.remove('d-none');
            customerResults.classList.add('d-none');
            customerQuery.value = '';
            validateForm();
        }

        function clearCustomer() {
            selectedCustomer = null;
            customerIdHidden.value = '0';
            customerSelected.classList.add('d-none');
            validateForm();
        }

        customerClear.addEventListener('click', clearCustomer);

        let customerTimer = null;
        customerQuery.addEventListener('input', () => {
            clearTimeout(customerTimer);
            const term = customerQuery.value.trim();
            if (term.length < 2) {
                customerResults.classList.add('d-none');
                customerResults.innerHTML = '';
                return;
            }
            customerTimer = setTimeout(async () => {
                const res = await fetch(`/Customers/Search?q=${encodeURIComponent(term)}`);
                const data = await res.json();
                customerResults.innerHTML = '';
                if (!Array.isArray(data) || data.length === 0) {
                    customerResults.classList.add('d-none');
                    return;
                }
                for (const c of data) {
                    const a = document.createElement('button');
                    a.type = 'button';
                    a.className = 'list-group-item list-group-item-action';
                    a.innerHTML = `<div class="fw-semibold">${c.fullName}</div><div class="small text-muted">${c.cedula}${c.email ? ' · ' + c.email : ''}</div>`;
                    a.addEventListener('click', () => setCustomer(c));
                    customerResults.appendChild(a);
                }
                customerResults.classList.remove('d-none');
            }, 250);
        });

        function addToCart(p) {
            clearMsg();
            const existing = cart.get(p.id);
            if (existing) {
                const nextQty = existing.qty + 1;
                if (nextQty > p.stock) {
                    showMsg(`Stock insuficiente: ${p.name}. Disponible: ${p.stock}.`);
                    return;
                }
                existing.qty = nextQty;
                cart.set(p.id, existing);
            } else {
                if (p.stock <= 0) {
                    showMsg(`Sin stock: ${p.name}.`);
                    return;
                }
                cart.set(p.id, { id: p.id, code: p.code, name: p.name, price: Number(p.price), stock: Number(p.stock), qty: 1 });
            }
            renderCart();
            validateForm();
        }

        function removeFromCart(id) {
            cart.delete(id);
            renderCart();
            validateForm();
        }

        function renderCart() {
            cartBody.innerHTML = '';
            if (cart.size === 0) {
                cartBody.appendChild(cartEmpty);
                cartEmpty.classList.remove('d-none');
                subtotalText.textContent = '$0.00';
                vatText.textContent = '$0.00';
                totalText.textContent = '$0.00';
                itemsInputs.innerHTML = '';
                return;
            }
            cartEmpty.classList.add('d-none');

            let i = 0;
            itemsInputs.innerHTML = '';
            for (const it of cart.values()) {
                const tr = document.createElement('tr');
                const lineSubtotal = it.price * it.qty;
                tr.innerHTML = `
                    <td class="fw-semibold">${it.code}</td>
                    <td>${it.name}<div class="small text-muted">Stock: ${it.stock}</div></td>
                    <td class="text-end">$${money(it.price)}</td>
                    <td>
                        <input class="form-control form-control-sm" type="number" min="1" max="${it.stock}" value="${it.qty}" data-id="${it.id}" style="width: 110px;">
                    </td>
                    <td class="text-end fw-semibold">$${money(lineSubtotal)}</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-remove="${it.id}"><i class="bi bi-x-lg"></i></button>
                    </td>
                `;
                cartBody.appendChild(tr);

                const inp1 = document.createElement('input');
                inp1.type = 'hidden';
                inp1.name = `Items[${i}].ProductId`;
                inp1.value = String(it.id);
                itemsInputs.appendChild(inp1);

                const inp2 = document.createElement('input');
                inp2.type = 'hidden';
                inp2.name = `Items[${i}].Quantity`;
                inp2.value = String(it.qty);
                itemsInputs.appendChild(inp2);

                i++;
            }

            cartBody.querySelectorAll('input[data-id]').forEach(el => {
                el.addEventListener('input', (e) => {
                    clearMsg();
                    const id = Number(e.target.getAttribute('data-id'));
                    const item = cart.get(id);
                    if (!item) return;
                    let v = Number(e.target.value);
                    if (!Number.isFinite(v) || v < 1) v = 1;
                    if (v > item.stock) {
                        v = item.stock;
                        showMsg(`Cantidad ajustada al stock disponible (${item.stock}).`);
                    }
                    item.qty = v;
                    cart.set(id, item);
                    renderCart();
                    validateForm();
                });
            });

            cartBody.querySelectorAll('button[data-remove]').forEach(btn => {
                btn.addEventListener('click', () => removeFromCart(Number(btn.getAttribute('data-remove'))));
            });

            updateTotals();
        }

        function updateTotals() {
            let subtotal = 0;
            for (const it of cart.values()) subtotal += it.price * it.qty;

            const vatRate = parseVatRate();
            const vat = subtotal * vatRate;
            const total = subtotal + vat;

            subtotalText.textContent = '$' + money(subtotal);
            vatText.textContent = '$' + money(vat);
            totalText.textContent = '$' + money(total);

            vatRateHidden.value = String(vatRate).replace('.', ',');
        }

        function parseVatRate() {
            const raw = (vatRateInput.value ?? '').trim();
            if (raw.length === 0) return 0.15;
            let pct = Number(raw.replace(',', '.'));
            if (!Number.isFinite(pct)) pct = 15;
            if (pct < 0) pct = 0;
            if (pct > 100) pct = 100;
            return pct / 100;
        }

        vatRateInput.addEventListener('input', () => {
            updateTotals();
            validateForm();
        });

        let productTimer = null;
        productQuery.addEventListener('input', () => {
            clearTimeout(productTimer);
            const term = productQuery.value.trim();
            if (term.length < 2) {
                productResults.classList.add('d-none');
                productResults.innerHTML = '';
                return;
            }
            productTimer = setTimeout(async () => {
                const res = await fetch(`/Products/Search?q=${encodeURIComponent(term)}`);
                const data = await res.json();
                productResults.innerHTML = '';
                if (!Array.isArray(data) || data.length === 0) {
                    productResults.classList.add('d-none');
                    return;
                }
                for (const p of data) {
                    const a = document.createElement('button');
                    a.type = 'button';
                    a.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                    a.innerHTML = `
                        <div>
                            <div class="fw-semibold">${p.code} · ${p.name}</div>
                            <div class="small text-muted">Stock: ${p.stock}</div>
                        </div>
                        <div class="fw-semibold">$${money(Number(p.price))}</div>
                    `;
                    a.addEventListener('click', () => {
                        addToCart(p);
                        productResults.classList.add('d-none');
                        productResults.innerHTML = '';
                        productQuery.value = '';
                    });
                    productResults.appendChild(a);
                }
                productResults.classList.remove('d-none');
            }, 250);
        });

        function validateForm() {
            const okCustomer = selectedCustomer && Number(customerIdHidden.value) > 0;
            const okItems = cart.size > 0;
            submitBtn.disabled = !(okCustomer && okItems);
            if (okItems) updateTotals();
        }

        validateForm();
    </script>
}
