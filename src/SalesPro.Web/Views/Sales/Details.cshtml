@model SalesPro.Application.Dtos.SaleDetailsDto

@{
    ViewData["Title"] = "Detalle venta";
    ViewData["Header"] = "Detalle venta";
}

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Factura</div>
                <div class="fs-4 fw-bold">@Model.InvoiceNumber</div>
                <div class="text-muted mt-2">Fecha</div>
                <div class="fw-semibold">@Model.SaleDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>

                <hr />

                <div class="text-muted">Cliente</div>
                <div class="fw-semibold">@Model.CustomerFullName</div>
                <div class="small text-muted">@Model.CustomerCedula</div>
                <div class="small text-muted">@Model.CustomerEmail</div>
                @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                {
                    <div class="small text-muted">@Model.CustomerPhone</div>
                }

                <div class="mt-4">
                    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-2"></i>Volver</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-3">Detalle</h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:130px;">Código</th>
                                <th>Producto</th>
                                <th style="width:110px;" class="text-end">Precio</th>
                                <th style="width:110px;" class="text-end">Cant.</th>
                                <th style="width:140px;" class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var it in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@it.ProductCode</td>
                                <td>@it.ProductName</td>
                                <td class="text-end">@it.UnitPrice.ToString("C")</td>
                                <td class="text-end">@it.Quantity</td>
                                <td class="text-end fw-semibold">@it.LineSubtotal.ToString("C")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end">
                    <div class="col-12 col-md-6">
                        <div class="card bg-light border">
                            <div class="card-body py-3">
                                <div class="d-flex justify-content-between">
                                    <div class="text-muted">Subtotal</div>
                                    <div class="fw-semibold">@Model.Subtotal.ToString("C")</div>
                                </div>
                                <div class="d-flex justify-content-between mt-1">
                                    <div class="text-muted">IVA (@(Model.VatRate * 100m).ToString("0.##"))%</div>
                                    <div class="fw-semibold">@Model.VatAmount.ToString("C")</div>
                                </div>
                                <div class="d-flex justify-content-between mt-2 pt-2 border-top">
                                    <div class="fw-semibold">Total</div>
                                    <div class="fw-bold fs-5">@Model.Total.ToString("C")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
