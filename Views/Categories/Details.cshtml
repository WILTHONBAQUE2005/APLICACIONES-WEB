
@model Category
@{
    ViewData["Title"] = "Detalle categoría";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="mb-0">@Model.Name</h4>
        <div class="text-secondary">@((Model.Description ?? "Sin descripción"))</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.CategoryId"><i class="bi bi-pencil-square me-1"></i>Editar</a>
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Estado</div>
                <div class="mt-1">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success">Activa</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary">Inactiva</span>
                    }
                </div>
                <div class="text-secondary small mt-3">Creado</div>
                <div class="fw-semibold">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="fw-semibold mb-2">Productos</div>
                @if (Model.Products.Count == 0)
                {
                    <div class="text-secondary">Sin productos en esta categoría.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>SKU</th>
                                    <th>Producto</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Products.OrderBy(x => x.Name))
                                {
                                    <tr>
                                        <td class="fw-semibold">@p.Sku</td>
                                        <td>@p.Name</td>
                                        <td class="text-end">$@p.UnitPrice.ToString("N2")</td>
                                        <td class="text-end">@p.Stock</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
