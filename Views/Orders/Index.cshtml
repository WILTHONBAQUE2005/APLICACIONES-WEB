
@model (OrderIndexFilterVm Filter, List<Order> Orders)
@{
    ViewData["Title"] = "Pedidos";
    var f = Model.Filter;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="mb-0">Pedidos</h4>
        <div class="text-secondary">Listado y seguimiento</div>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Nuevo</a>
</div>

<form class="row g-2 mb-3" method="get">
    <div class="col-12 col-md-4">
        <input class="form-control" name="Search" value="@f.Search" placeholder="Número de pedido, cliente o cédula" />
    </div>
    <div class="col-12 col-md-2">
        <select class="form-select" name="Status" asp-items="@(ViewBag.StatusList as SelectList)">
            <option value="">Todos los estados</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <input class="form-control" type="date" name="From" value="@(f.From?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-6 col-md-2">
        <input class="form-control" type="date" name="To" value="@(f.To?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-12 col-md-2">
        <button class="btn btn-outline-secondary w-100" type="submit"><i class="bi bi-funnel me-1"></i>Filtrar</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Pago</th>
                    <th class="text-end">Total</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders)
                {
                    <tr>
                        <td class="fw-semibold">@o.OrderNumber</td>
                        <td>@(o.Customer != null ? o.Customer.FullName : "-")</td>
                        <td>@o.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@o.Status</span></td>
                        <td>
                            @if (o.PaymentStatus == PaymentStatus.Paid)
                            {
                                <span class="badge bg-success-subtle text-success">@o.PaymentStatus</span>
                            }
                            else if (o.PaymentStatus == PaymentStatus.Partial)
                            {
                                <span class="badge bg-warning-subtle text-warning">@o.PaymentStatus</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">@o.PaymentStatus</span>
                            }
                        </td>
                        <td class="text-end">$@o.Total.ToString("N2")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@o.OrderId">Abrir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
