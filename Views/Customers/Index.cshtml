
@model List<Customer>
@{
    ViewData["Title"] = "Clientes";
    var q = Context.Request.Query["q"].ToString();
    var showInactive = Context.Request.Query["showInactive"].ToString() == "true";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="mb-0">Clientes</h4>
        <div class="text-secondary">Gestión de clientes</div>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Nuevo</a>
</div>

<form class="row g-2 mb-3" method="get">
    <div class="col-12 col-md-5">
        <input class="form-control" name="q" value="@q" placeholder="Buscar por cédula, nombre o email" />
    </div>
    <div class="col-12 col-md-3">
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" name="showInactive" value="true" id="showInactive" @(showInactive ? "checked" : "") />
            <label class="form-check-label" for="showInactive">Mostrar inactivos</label>
        </div>
    </div>
    <div class="col-12 col-md-2">
        <button class="btn btn-outline-secondary w-100" type="submit"><i class="bi bi-search me-1"></i>Filtrar</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Cédula</th>
                    <th>Cliente</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.DocumentNumber</td>
                        <td>@c.FullName</td>
                        <td>@c.Email</td>
                        <td>@(c.Phone ?? "-")</td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@c.CustomerId">Abrir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
