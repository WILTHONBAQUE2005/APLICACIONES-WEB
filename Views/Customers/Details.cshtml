
@model Customer
@{
    ViewData["Title"] = "Detalle cliente";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="mb-0">@Model.FullName</h4>
        <div class="text-secondary">Cédula: <span class="fw-semibold">@Model.DocumentNumber</span></div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.CustomerId"><i class="bi bi-pencil-square me-1"></i>Editar</a>
        <form method="post" asp-action="ToggleActive" asp-route-id="@Model.CustomerId">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-secondary" type="submit">
                @if (Model.IsActive)
                {
                    <text><i class="bi bi-person-x me-1"></i>Desactivar</text>
                }
                else
                {
                    <text><i class="bi bi-person-check me-1"></i>Activar</text>
                }
            </button>
        </form>
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="text-secondary small">Email</div>
                        <div class="fw-semibold">@Model.Email</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="text-secondary small">Teléfono</div>
                        <div class="fw-semibold">@((Model.Phone ?? "-"))</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="text-secondary small">Estado</div>
                        <div>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Inactivo</span>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="text-secondary small">Creado</div>
                        <div class="fw-semibold">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="fw-semibold mb-2">Direcciones</div>
                @if (Model.Addresses.Count == 0)
                {
                    <div class="text-secondary">Sin direcciones registradas.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var a in Model.Addresses)
                        {
                            <div class="list-group-item px-0">
                                <div class="fw-semibold">@a.Line1</div>
                                <div class="text-secondary small">@a.City, @a.Province, @a.Country</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
