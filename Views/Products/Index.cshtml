
@model List<Product>
@{
    ViewData["Title"] = "Productos";
    var q = Context.Request.Query["q"].ToString();
    var categoryId = Context.Request.Query["categoryId"].ToString();
    var showInactive = Context.Request.Query["showInactive"].ToString() == "true";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h4 class="mb-0">Productos</h4>
        <div class="text-secondary">Catálogo e inventario</div>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Nuevo</a>
</div>

<form class="row g-2 mb-3" method="get">
    <div class="col-12 col-md-4">
        <input class="form-control" name="q" value="@q" placeholder="Buscar por SKU o nombre" />
    </div>
    <div class="col-12 col-md-3">
        <select class="form-select" name="categoryId" asp-items="@(ViewBag.Categories as SelectList)">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-12 col-md-3">
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" name="showInactive" value="true" id="showInactive" @(showInactive ? "checked" : "") />
            <label class="form-check-label" for="showInactive">Mostrar inactivos</label>
        </div>
    </div>
    <div class="col-12 col-md-2">
        <button class="btn btn-outline-secondary w-100" type="submit"><i class="bi bi-search me-1"></i>Filtrar</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>SKU</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Stock</th>
                    <th>Estado</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">@p.Sku</td>
                        <td>@p.Name</td>
                        <td>@(p.Category?.Name ?? "-")</td>
                        <td class="text-end">$@p.UnitPrice.ToString("N2")</td>
                        <td class="text-end">
                            @if (p.Stock <= 5)
                            {
                                <span class="badge bg-danger-subtle text-danger">@p.Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success">@p.Stock</span>
                            }
                        </td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@p.ProductId">Abrir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
